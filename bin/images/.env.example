# Copiaza in bin/images/.env si completeaza. Fisierul .env nu se comite.
# Daca lipseste, scripturile citesc OPENAI_API_KEY din bin/import/.env.

# platform.openai.com > API keys
OPENAI_API_KEY=sk-...

# Modelele (optional)
HT_COPY_MODEL=gpt-4o
HT_IMAGE_MODEL=gpt-image-2
HT_IMAGE_QUALITY=medium

# Figma > Settings > Security > Personal access tokens (drept: File content, read)
# Folosit doar de upload_to_wp.php, la exportul cadrelor.
FIGMA_TOKEN=figd_...
FIGMA_FILE_KEY=kcN6mD2YKtUttVTf3f26i2
