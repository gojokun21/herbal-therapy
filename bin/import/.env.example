# Copiaza in bin/import/.env si completeaza. Fisierul .env nu se comite.
# Aici NU se pun valori reale: acest fisier ajunge in git.

# platform.openai.com > API keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WooCommerce > Setari > Avansat > API REST (drepturi: Citire/Scriere)
WC_URL=http://herbaltherapy.local
WC_KEY=ck_...
WC_SECRET=cs_...

# Utilizatori > Profil > Parole de aplicatie.
# ATENTIE: nu parola cu care intri in WordPress, ci cea generata acolo.
# Se copiaza cu spatii cu tot, asa cum o afiseaza.
WP_USER=herbal_admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Lista oficiala de produse
XLSX_PATH=C:\Users\Natalia\Downloads\produsele tralala.xlsx
